---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tenant } from '../config/tenant';
import { getGalleryItems } from '../lib/api';

const items = await getGalleryItems();
---

<BaseLayout
  title="Gallery"
  description={`Photos from ${tenant.displayName} activities.`}
  path="/gallery"
>
  <section class="page-hero">
    <div class="container">
      <span class="section__eyebrow">Moments</span>
      <h1>Gallery</h1>
      <p class="section__lead">Published albums and moments from the branch.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container gallery-grid">
      {
        items.length === 0 ? (
          <p class="section__lead">No gallery items published yet.</p>
        ) : (
          items.map((g) => (
            <figure>
              <img src={g.src} alt={g.alt} width="800" height="600" loading="lazy" />
            </figure>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>
