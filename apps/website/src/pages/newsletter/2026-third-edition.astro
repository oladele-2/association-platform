---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import NewsletterEdition from '../../components/NewsletterEdition.astro';
import { publication, secretariatEmail } from '../../data/home';
import { issue, interview, newsletterEdition } from '../../data/newsletter';
import media from '../../data/newsletter-media-2026.json';
import '../../styles/home.css';
import '../../styles/newsletter.css';
const edition = newsletterEdition(publication);
const features = issue.features.filter(feature => publication.entries.some(entry => entry.kind === 'article' && entry.content.slug === feature.slug));
const interviewEntry = publication.entries.find(entry => entry.kind === 'article' && entry.content.slug === interview.slug);
const photos = media.photos.filter(photo => photo.group === 'advocacy' && publication.media.some(item => item.id === photo.id));
const pdf = (page: number) => `${edition?.href ?? '/newsletter'}#page=${page}`;
---
<BaseLayout title="Third Edition, 2026 — Biannual Newsletter — NMA Ogun" description="Read NMA Ogun’s 52-page biannual newsletter: professional features, the Sacred Heart Hospital interview, association photonews and affiliate reports.">
  <PageHero eyebrow="Third Edition · 2026" title="Our profession. In our own words." description="A biannual publication of the Nigerian Medical Association, Ogun State Branch. Explore the complete edition and selected contributions from its authors." parent={{label:'Newsletter',href:'/newsletter'}} />
  {edition ? <>
  <NewsletterEdition />
  <nav class="container issue-nav" aria-label="In this edition"><a href="#features">Features</a><a href="#interview">The interview</a><a href="#professional-reading">Professional reading</a><a href="#photonews">Photonews</a><a href="#editorial-board">Editorial board</a><a href="#full-edition">Full edition</a></nav>
  <section class="container issue-section issue-messages" aria-label="Leadership and editorial messages"><article><p class="eyebrow">From the chairman</p><blockquote>“A stronger NMA, a better healthcare system, and a healthier Ogun State.”</blockquote><p>Dr Sunday Enimola’s address introduces the newsletter as a platform for communication, advocacy, reflection and connection between the profession and the wider community.</p><p class="newsletter-note">Dr Sunday Enimola · Chairman · Newsletter, printed page 2.</p><a class="text-link" href={pdf(4)}>Read the chairman’s address ↗</a></article><article><p class="eyebrow">From the editor</p><h2>A shared record.<br /><em>A continuing conversation.</em></h2><p>Editor-in-Chief Dr Yesir A. Kareem introduces a biannual publication bringing together professional reflection, public-health discussion, innovation and the activities of NMA Ogun and its affiliates.</p><a class="text-link" href={pdf(5)}>Read the editorial note ↗</a></article></section>
  <section class="container issue-section" id="features"><p class="eyebrow">Ideas from the edition</p><h2>Read, reflect and <em>share.</em></h2><p class="issue-intro">These web features are editorial adaptations of the named contributors’ articles. Each credits its author and links to the original contribution and any references in the complete newsletter.</p><div class="issue-card-grid">{features.map(feature => <article class="issue-card"><span class="programme-status">{feature.category}</span><h3><a href={`/news/${feature.slug}`}>{feature.title}</a></h3><p>{feature.summary}</p><p class="newsletter-note">{feature.author} · Print pp. {feature.printedPages}</p><a class="text-link" href={`/news/${feature.slug}`}>Read feature ↗</a></article>)}</div></section>
  {interviewEntry && <section class="container issue-section issue-interview" id="interview"><figure><img src={`/media/${media.photos.find(photo => photo.group === 'interview')?.id}`} alt="The NMA Ogun newsletter interview at Sacred Heart Hospital" loading="lazy" width="788" height="455" /><figcaption>From the newsletter interview at Sacred Heart Hospital, Lantoro, Abeokuta.</figcaption></figure><div><p class="eyebrow">The interview · Print pp. 13–17</p><h2>Service, training<br />and <em>leadership.</em></h2><p>Dr Gregory Arifalo discusses Sacred Heart Hospital’s mission, professional development and the work of leading a healthcare team.</p><p class="newsletter-note">Interviewers: Dr Peace Ugbodaga, Dr Temitope Joseph and Dr Tolulope Omitade.</p><a class="button" href={`/news/${interview.slug}`}>Read selected questions &amp; answers ↗</a><a class="text-link section-link" href={pdf(15)}>Read the complete interview in the PDF ↗</a></div></section>}
  <section class="container issue-section" id="professional-reading"><p class="eyebrow">Clinical and research contributions</p><h2>Professional <em>reading.</em></h2><p class="issue-intro">Read these contributions in their original layout, with their authors’ context and stated limitations. They are professional discussion from the 2026 edition, rather than newly issued treatment protocols or national policy. Clinical decisions require current guidance and appropriate professional judgement.</p><div class="issue-card-grid">{issue.clinicalReadings.map(item => <article class="issue-card"><h3>{item.title}</h3><p>{item.description}</p><p class="newsletter-note">{item.author} · Print pp. {item.printedPages}</p><a class="text-link" href={pdf(item.page)}>Read original contribution ↗</a></article>)}</div><p class="newsletter-note">Further reading: <a href="https://www.who.int/publications/i/item/9789240084759" rel="noopener noreferrer">WHO guidance on AI governance</a> · <a href="https://www.who.int/publications/i/item/9789240053052" rel="noopener noreferrer">WHO guidelines on mental health at work</a>.</p></section>
  <section class="container issue-section" id="photonews"><p class="eyebrow">Association photonews</p><h2>Connection through <em>action.</em></h2><p class="issue-intro">Courtesy visits, professional engagement and meetings recorded in the Third Edition. Photographs are captioned in their newsletter context.</p><div class="issue-photo-grid">{photos.slice(0,3).map(photo => <figure><a href={`/media/${photo.id}`} data-photo={`/media/${photo.id}`} data-caption={photo.caption}><img src={`/media/${photo.id}`} alt={photo.caption} width="665" height="468" loading="lazy" /></a><figcaption>{photo.caption}</figcaption></figure>)}</div><div class="home-link-row"><a class="button" href="/gallery/newsletter-2026-association-photonews">Association photonews album ↗</a><a class="text-link" href="/gallery/newsletter-2026-affiliate-activities">Affiliate activities album ↗</a></div></section>
  <section class="container issue-section" id="affiliate-reports"><p class="eyebrow">Across the NMA Ogun family</p><h2>Affiliate voices. <em>Shared purpose.</em></h2><p>The edition includes contributions and photographs from MDCAN NPH Aro, ARD OOUTH, ARD NPH Aro, MWAN Ogun, ARD FMC Abeokuta, ARD BUTH, MDCAN HMB–MOH and Sacred Heart Hospital.</p><div class="issue-card-grid"><article class="issue-card"><h3>Affiliate reports &amp; photographs</h3><p>Explore meetings, professional learning, advocacy and community activities in the original edition.</p><a class="text-link" href={pdf(40)}>Read affiliate coverage · PDF pp. 40–48 ↗</a></article><article class="issue-card"><h3>Service and institutional memory</h3><p>Read the Sacred Heart Hospital heritage feature, the tribute to immediate past leadership and the creative contributions that close the edition.</p><a class="text-link" href={pdf(48)}>Explore heritage, tribute &amp; poetry ↗</a></article><article class="issue-card"><h3>Association services</h3><p>The back cover introduces Doctors’ House venue hire, bus-hire enquiries and the member portal.</p><a class="text-link" href="/facilities">Explore facilities &amp; services ↗</a></article></div></section>
  <section class="container issue-section" id="editorial-board"><p class="eyebrow">The people behind the publication</p><h2>The editorial <em>board.</em></h2><p class="newsletter-note">Roles as published in this edition, printed page 5.</p><dl class="issue-board">{issue.board.map(([name,role]) => <div><dt>{name}</dt><dd>{role}</dd></div>)}</dl><p>For contributions and editorial enquiries, contact the Secretariat at <a href={`mailto:${secretariatEmail}?subject=Newsletter%20editorial%20enquiry`}>{secretariatEmail}</a>. Future submission arrangements will be announced separately.</p></section>
  <section class="container issue-section issue-journal"><div><p class="eyebrow">Research &amp; publication</p><h2>Discover the<br /><em>Gateway Medical Journal.</em></h2><p>The newsletter introduces NMA Ogun’s journal and its manuscript-submission process. Journal manuscripts and newsletter contributions follow separate editorial processes.</p><a class="text-link" href="/research">Journal information &amp; submission links ↗</a></div><div><p class="eyebrow">From the back cover</p><h3>More ways to connect.</h3><p>Find the member portal, enquire about Doctors’ House or ask about group transport for association and professional activities.</p><a class="text-link" href="/facilities">Facilities &amp; services ↗</a></div></section>
  <section class="container issue-section" id="full-edition"><p class="eyebrow">Keep the complete edition</p><h2>All 52 pages.<br /><em>One shared record.</em></h2><p>The optimised web copy retains the original page sequence and selectable text, including the blank inside-cover page. Photographs are compressed, bookmarks are added and the visible publication-frequency headers read biannual. The original supplied file is preserved separately.</p><div class="home-link-row"><a class="button" href={edition.href} target="_blank" rel="noopener noreferrer">Read online · {edition.megabytes} MB ↗</a><a class="text-link" href={edition.href} download="nma-ogun-newsletter-third-edition-2026.pdf">Download the PDF ↓</a></div><p class="newsletter-note">Advertisements, contacts, services and dated notices in the PDF reflect the printed edition. Confirm current arrangements before responding or travelling.</p></section>
  </> : <section class="container page-section"><h2>This edition is currently unavailable.</h2><a href="/newsletter">Return to the newsletter desk</a></section>}
</BaseLayout>
