---
import { affiliateSeeds } from '../../vendor/website-content/affiliates.ts';
const selected = ['buth-ard', 'ard-fmc-abk', 'nda-ogun'].map(slug => affiliateSeeds.find(item => item.slug === slug)!);
---
<section class="container home-section featured-affiliates" aria-labelledby="affiliate-feature-title"><div class="home-section-heading"><div><p class="eyebrow">Our affiliate family</p><h2 id="affiliate-feature-title">Many communities.<br /><em>One shared purpose.</em></h2></div><a class="text-link" href="/affiliates">Explore all affiliates ↗</a></div><div class="affiliate-logo-grid">{selected.map(item => <a class="affiliate-logo-card" href={`/affiliates/${item.slug}`}><img src={item.logo!.src} alt={item.logo!.alt} width="160" height="160" loading="lazy" decoding="async" /><h3>{item.shortName}</h3><p>{item.summary}</p><span class="text-link">Meet this affiliate ↗</span></a>)}</div></section>
