---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Membership from '../components/Membership.astro';
import Gallery from '../components/Gallery.astro';
import { reviewMode } from '../data/site';
---
<BaseLayout title="NMA Ogun — Nigerian Medical Association, Ogun State Branch" description="Explore NMA Ogun, its purpose, professional community and member services.">

    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow"><span class="short-rule"></span> The profession. The people. The purpose.</p><h1 id="hero-title">A stronger<br>medical<br>community.<br><em>A healthier Ogun.</em></h1><p class="hero-description">Supporting medical and dental practitioners through professional development, advocacy and a shared commitment to quality healthcare in Ogun State.</p><div class="hero-actions"><a class="button" href="https://portal.nmaogun.com.ng/login">Member portal <span aria-hidden="true">↗</span></a><a class="text-link" href="/about">Explore NMA Ogun <span aria-hidden="true">↗</span></a></div><div class="hero-footnote"><span class="tiny-cross" aria-hidden="true">✳</span><span>United by a commitment to care.</span></div></div>
      <figure class="hero-visual"><div class="image-frame"><Photo name="community-meeting" alt="Participants seated around a meeting table in an NMA Ogun-branded room" loading="eager" fetchpriority="high" /></div><figcaption><span class="image-index">01 — OUR COMMUNITY</span><span>Shared purpose.<br><strong>Collective progress.</strong></span><span class="caption-arrow" aria-hidden="true">↗</span></figcaption></figure>
    </section>
    <div class="values-ribbon"><div class="container"><span>Professional excellence</span><span aria-hidden="true">✳</span><span>Members’ welfare</span><span aria-hidden="true">✳</span><span>Compassionate service</span><span aria-hidden="true">✳</span><span>Integrity</span></div></div>
    <section class="intro-section container section-space" aria-labelledby="intro-title"><div class="intro-image"><Photo name="doctors-house" alt="Exterior of a green two-storey building bearing the NMA emblem" /><span class="photo-label">A place for our community.</span></div><div class="intro-copy"><p class="eyebrow">Welcome to NMA Ogun</p><h2 id="intro-title">For the profession.<br><em>For the people<br>we serve.</em></h2><p>NMA Ogun is the Ogun State Branch of the Nigerian Medical Association. Our work brings together professional development, advocacy, members’ welfare and public education to support better healthcare.</p><a class="text-link" href="/about">Get to know the association <span aria-hidden="true">↗</span></a></div></section>
    <section class="purpose-section" aria-labelledby="purpose-title"><div class="container purpose-layout"><div class="section-heading"><p class="eyebrow">What brings us together</p><h2 id="purpose-title">A profession<br>with <em>purpose.</em></h2><p>Shared values shape how we learn, serve and stand together.</p><a class="text-link" href="/about#purpose">Our mission &amp; values <span aria-hidden="true">↗</span></a><div class="purpose-mark" aria-hidden="true">✳</div></div><div class="purpose-list">
      <details open><summary><span class="row-number">01</span><h3>Professional development</h3><span class="disclosure-icon" aria-hidden="true"></span></summary><p>Supporting continuing learning, knowledge sharing and high standards of practice.</p></details>
      <details><summary><span class="row-number">02</span><h3>Members’ welfare</h3><span class="disclosure-icon" aria-hidden="true"></span></summary><p>Giving the interests and wellbeing of members a place in the association’s work.</p></details>
      <details><summary><span class="row-number">03</span><h3>Advocacy &amp; public education</h3><span class="disclosure-icon" aria-hidden="true"></span></summary><p>Contributing to health policy and helping communities understand health issues.</p></details>
      <details><summary><span class="row-number">04</span><h3>Ethics &amp; service</h3><span class="disclosure-icon" aria-hidden="true"></span></summary><p>Encouraging integrity, compassionate service, professionalism and excellence.</p></details>
    </div></div></section>
    <section class="gallery-section container section-space" id="gallery" aria-labelledby="gallery-title"><div class="section-top"><div><p class="eyebrow">A closer look</p><h2 id="gallery-title">Our community,<br><em>in pictures.</em></h2></div><p>A view of the association’s<br>spaces and meeting life.</p></div><Gallery names={["meeting-life", "courtyard", "community-meeting"]} /><a class="text-link section-link" href="/gallery">Explore the gallery <span aria-hidden="true">↗</span></a></section>
    <section class="container section-space programme-intro"><div><p class="eyebrow">Learning &amp; connection</p><h2>A profession that<br /><em>keeps growing.</em></h2></div><div><p>Professional learning, association activities and a shared commitment to service connect our community.</p><a class="text-link" href="/programmes">Explore our programmes <span aria-hidden="true">↗</span></a></div></section>
{reviewMode && <section class="leadership-teaser container"><p class="eyebrow">People &amp; purpose</p><h2>Leadership in service<br /><em>of the profession.</em></h2><p>Meet the officers and committees supporting the work of NMA Ogun.</p><a class="text-link" href="/leadership">Explore leadership <span aria-hidden="true">↗</span></a></section>}
<Membership />
  
</BaseLayout>
