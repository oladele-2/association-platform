---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PhotobookImage from '../components/PhotobookImage.astro';
import PhotobookGallery from '../components/PhotobookGallery.astro';
import { book, bookAlbums, curatedPages } from '../data/photobook-content.mjs';
import stories from '../data/photobook-stories.json';
const pdfSize = (book.pdfBytes / 1024 / 1024).toFixed(1);
---
<BaseLayout title="NMA Ogun Photobook — Leadership, advocacy & community in pictures" description="Explore NMA Ogun’s 2026–2028 administration in pictures: elections, stakeholder engagements, Doctors’ House, community outreach and Physicians’ Week. Browse albums and the 61-page working edition.">
  <PageHero eyebrow="The NMA Ogun photobook" title="Our work. Our people. Our shared story." description="A photographic record of the 2026–2028 administration. This working edition documents activities from July to October 2026." photograph={false} />
  <section class="container book-hero" aria-labelledby="book-edition-title"><div><p class="eyebrow">2026–2028 administration</p><h2 id="book-edition-title">A community<br />in motion.</h2><p>From the first executive meetings to advocacy visits and community outreach, discover the occasions that bring the association together.</p><div class="book-actions"><a class="button button-cream" href="#albums">Explore the albums ↗</a><a class="text-link" href="#photographs">Search photographs ↗</a></div><p class="book-note">Working edition · 61 pages · Activities documented through 20 October 2026. The tenure is 2026–2028; this is a record of the activities currently included.</p></div><PhotobookImage page={59} eager /></section>
  <section class="container page-section book-section" id="albums"><p class="eyebrow">Explore by occasion</p><h2>Many moments.<br /><em>One association.</em></h2><div class="book-albums">{bookAlbums.map(album => <a class="book-album" href={`/gallery/${album.slug}`}><PhotobookImage page={album.cover} /><h3>{album.title}</h3><p>{album.description}</p><span>{album.pages.length} photographs ↗</span></a>)}</div></section>
  <section class="container page-section book-section" aria-labelledby="book-reports-title"><p class="eyebrow">Behind the photographs</p><h2 id="book-reports-title">Reports from the record.</h2><div class="book-articles">{stories.map(story => <article><h3><a href={`/news/${story.slug}`}>{story.title}</a></h3><p>{story.summary}</p><a class="text-link" href={`/news/${story.slug}`}>Read the photo report ↗</a></article>)}</div></section>
  <section class="container page-section book-panel" aria-labelledby="book-pdf-title"><p class="eyebrow">The original publication, prepared for the web</p><h2 id="book-pdf-title">Keep the full story.</h2><p>The web edition retains all 61 pages and the source captions, with compressed photographs for a smaller download. It is labelled as a working edition; provisional dates and unconfirmed details remain identified.</p><div class="book-actions"><a class="button" href={book.pdf} target="_blank" rel="noopener">Open the PDF ↗</a><a class="text-link" href={book.pdf} download="NMA-Ogun-Photobook-2026-Working-Edition.pdf">Download working edition ↓</a></div><p class="book-note">PDF · {pdfSize} MB · 61 pages. Opens in your browser’s PDF viewer where supported; you can also download it to your device.</p></section>
  <section class="container page-section book-section" id="photographs"><p class="eyebrow">Find a moment</p><h2>Browse the photographic archive.</h2><p>Search captions by occasion, person, institution or date, or select an album. Expand a photograph to see it in greater detail.</p><form data-directory-search="photobook-results" data-result-label="photograph" role="search" aria-label="Search the photobook"><label for="photobook-query">Search photographs</label><div class="book-tools"><input id="photobook-query" type="search" placeholder="Try outreach, Commissioner, NEC or October" aria-controls="photobook-results" /><select aria-label="Filter photographs by album" data-category-filter><option value="">All albums</option>{bookAlbums.map(album => <option value={album.slug}>{album.title}</option>)}</select><button type="button" data-clear-search>Clear search</button></div><p role="status" aria-live="polite" data-result-count>{curatedPages.length} photographs</p><noscript><p>All photographs appear below. Use your browser’s Find feature to search captions.</p></noscript></form><p data-directory-empty hidden>No photographs match your search. Try another occasion, name or date.</p><div class="book-results"><PhotobookGallery pages={curatedPages} searchable id="photobook-results" /></div></section>
  <section class="container page-section prose"><h2>Help keep our record accurate.</h2><p>Captions follow the supplied photobook. Where a photograph date is provisional or unconfirmed, that qualification is retained. The complete PDF also includes material beyond the selected web albums.</p><p>For documented caption corrections or additional approved photographs, contact <a href="mailto:nmaogunstate@gmail.com?subject=NMA%20Ogun%20photobook">nmaogunstate@gmail.com</a>.</p></section>
</BaseLayout>
