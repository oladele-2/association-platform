// Production website. Exact hosts keep the member portal separate.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nma-ogun-website",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PUBLIC_RELEASE": "true" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "routes": [
    { "pattern": "nmaogun.com.ng", "custom_domain": true },
    { "pattern": "www.nmaogun.com.ng", "custom_domain": true },
  ],
  "observability": { "enabled": false },
}
