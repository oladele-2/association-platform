---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotobookFeature from '../components/PhotobookFeature.astro';
import HomeSlideshow from '../components/HomeSlideshow.astro';
import PhysiciansWeekFeature from '../components/PhysiciansWeekFeature.astro';
import MemberBenefits from '../components/MemberBenefits.astro';
import CommitteeSpotlights from '../components/CommitteeSpotlights.astro';
import FeaturedAffiliates from '../components/FeaturedAffiliates.astro';
import HeritageNewsletter from '../components/HeritageNewsletter.astro';
import Photo from '../components/Photo.astro';
import Membership from '../components/Membership.astro';
import Gallery from '../components/Gallery.astro';
import { homeArticles, upcomingEvents, chairman, chairmanPhoto, secretariatEmail, publication as publicationForNewsletter } from '../data/home';
import { newsletterEdition, issuePath } from '../data/newsletter';
import '../styles/newsletter.css';
import { longDate } from '../data/editorial';
import '../styles/home.css';
import '../styles/resource-features.css';
const nextEvent = upcomingEvents[0];
const newsletter = newsletterEdition(publicationForNewsletter);
---
<BaseLayout title="NMA Ogun — Nigerian Medical Association, Ogun State Branch" description="News, professional learning, membership and community from the Nigerian Medical Association, Ogun State Branch.">
  <HomeSlideshow />
  <div class="values-ribbon"><div class="container"><span>Professional excellence</span><span aria-hidden="true">✳</span><span>Members’ welfare</span><span aria-hidden="true">✳</span><span>Compassionate service</span><span aria-hidden="true">✳</span><span>Integrity</span></div></div>
  <PhysiciansWeekFeature />
  <section class="container home-section" aria-labelledby="news-title">
    <div class="home-section-heading"><div><p class="eyebrow">From the association</p><h2 id="news-title">Latest news <em>&amp; ideas.</em></h2></div><a class="text-link" href="/news">All news &amp; articles <span aria-hidden="true">↗</span></a></div>
    {homeArticles.length > 0 ? <div class="home-news-grid">{homeArticles.slice(0, 3).map((entry, index) => <article class="home-news-card"><span class="home-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><time datetime={entry.content.date}>{longDate(entry.content.date)}</time><h3><a href={`/news/${entry.content.slug}`}>{entry.content.title}</a></h3><p>{entry.content.summary}</p><a class="text-link" href={`/news/${entry.content.slug}`}>Read article <span aria-hidden="true">↗</span></a></article>)}</div> : <p>Association news will appear here when published. Explore our programmes and membership guidance below.</p>}
    <form class="home-search" action="/news" method="get" role="search" aria-label="Search published articles"><label for="home-search">Looking for a particular topic?</label><div><input id="home-search" name="q" type="search" placeholder="Search articles by title, topic or author" required maxlength="160" /><button class="button" type="submit">Search articles <span aria-hidden="true">↗</span></button></div></form>
  </section>
  <section class="home-learning" aria-labelledby="learning-title"><div class="container home-learning-grid"><div><p class="eyebrow">Learning &amp; connection</p><h2 id="learning-title">Make time<br />to <em>keep growing.</em></h2><p>Explore professional learning, scientific exchange and the conversations that help our profession move forward.</p><a class="text-link" href="/programmes">Explore our programmes <span aria-hidden="true">↗</span></a></div><div class="home-programme-card">{nextEvent ? <><p class="eyebrow">Next published event</p><time datetime={nextEvent.content.date}>{longDate(nextEvent.content.date)}</time><h3>{nextEvent.content.title}</h3><p>{nextEvent.content.summary}</p>{nextEvent.content.venue && <p><strong>Venue / format:</strong> {nextEvent.content.venue}</p>}<a class="button" href={`/events/${nextEvent.content.slug}`}>Event details <span aria-hidden="true">↗</span></a></> : <><span class="programme-status">Proposed programme</span><p class="eyebrow">October 2026 – September 2027</p><h3>The year ahead.<br />Topics worth making time for.</h3><p>Twelve monthly themes covering clinical practice, research, doctors’ wellbeing and leadership.</p><p class="home-note">Exact dates, speakers and registration arrangements will be announced when confirmed.</p><a class="button" href="/programmes/year-ahead">Explore the monthly programme <span aria-hidden="true">↗</span></a></>}</div></div></section>
  <MemberBenefits />
  <section class="container home-welcome" aria-labelledby="welcome-title"><div class="home-welcome-image">{chairman && chairmanPhoto ? <img src={`/media/${chairmanPhoto.id}`} alt={chairmanPhoto.alt} width="480" height="480" loading="lazy" decoding="async" /> : <Photo name="doctors-house" />}{chairman && <div class="home-officer"><strong>{chairman.content.title}</strong><span>{chairman.content.office} · {chairman.content.term}</span></div>}</div><div><p class="eyebrow">Welcome to NMA Ogun</p><h2 id="welcome-title">For the profession.<br /><em>For the people we serve.</em></h2><p>We bring medical and dental practitioners together around professional development, ethical practice, advocacy and members’ welfare.</p><p>Whether you are beginning your career, contributing years of experience or connecting with the association for the first time, there is a place for you in this community.</p>{chairman && <p class="home-note">{chairman.content.summary}</p>}{newsletter && <blockquote class="newsletter-welcome-quote">“A stronger NMA, a better healthcare system, and a healthier Ogun State.”<cite>Dr Sunday Enimola · Chairman’s address, Third Edition, 2026 newsletter. <a href={issuePath}>Read the edition ↗</a></cite></blockquote>}<div class="home-link-row"><a class="text-link" href="/about">Our purpose &amp; values ↗</a><a class="text-link" href="/executives">Meet our leadership ↗</a></div></div></section>
  <CommitteeSpotlights />
  <HeritageNewsletter />
  <PhotobookFeature />
  <section class="gallery-section container home-section" aria-labelledby="gallery-title"><div class="home-section-heading"><div><p class="eyebrow">A closer look</p><h2 id="gallery-title">Our community,<br /><em>in pictures.</em></h2></div><a class="text-link" href="/gallery">Explore the gallery ↗</a></div><Gallery names={["thanksgiving-congregation", "thanksgiving-community", "meeting-life"]} /></section>
  <FeaturedAffiliates />
  <Membership />
  <section class="container home-contact home-section" aria-labelledby="contact-title"><div><p class="eyebrow">The Secretariat</p><h2 id="contact-title">Let’s <em>connect.</em></h2><p>For association enquiries, partnerships and membership guidance, contact NMA Ogun State Secretariat.</p></div><div><a class="home-email" href={`mailto:${secretariatEmail}`}>{secretariatEmail}</a><p>For directions to Doctors’ House or to arrange a visit, please email the Secretariat.</p><a class="text-link" href="/contact">Contact &amp; enquiry guidance ↗</a></div></section>
</BaseLayout>
