---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { secretariatEmail } from '../data/home';
import '../styles/home.css';
---
<BaseLayout title="Contact the Secretariat — NMA Ogun" description="Contact NMA Ogun State Secretariat for association enquiries, partnerships, membership guidance and visits to Doctors’ House.">
  <PageHero eyebrow="Contact" title="A conversation starts here." description="Get in touch with NMA Ogun State Secretariat for association enquiries, membership guidance and opportunities to work together." />
  <section class="container page-section contact-layout"><div class="contact-panel"><p class="eyebrow">NMA Ogun State Secretariat</p><h2>Email the Secretariat</h2><a class="home-email" href={`mailto:${secretariatEmail}`}>{secretariatEmail}</a><p>Please include a clear subject and a brief description of your enquiry so it can be directed to the right person.</p><a class="button" href={`mailto:${secretariatEmail}`}>Write an email <span aria-hidden="true">↗</span></a></div><div class="contact-panel"><p class="eyebrow">Visiting Doctors’ House</p><h2>Plan your visit</h2><p>Doctors’ House is at Lukosi Road, off Abiola Way, Leme, Abeokuta, as published in the 2026 newsletter. Please email the Secretariat to confirm directions and arrange your visit.</p><p>For programme dates, participation and registration enquiries, mention the programme title and proposed month.</p><a class="text-link" href="/facilities">Venue and bus-hire enquiries ↗</a></div></section>
  <section class="container page-section"><p class="eyebrow">Useful to know</p><h2>Before you get in touch</h2><div class="faq"><details><summary>I need help accessing the member portal.</summary><p>Try <a href="https://portal.nmaogun.com.ng/forgot-password">account recovery</a> first. If you still need help, describe the problem in your email. Do not send your password or verification codes.</p></details><details><summary>I would like to join NMA Ogun.</summary><p>Read the <a href="/membership">membership guidance</a> and begin through the <a href="https://portal.nmaogun.com.ng/register">portal registration form</a>. Email the Secretariat if you need further guidance.</p></details><details><summary>I have a partnership or media enquiry.</summary><p>Email the Secretariat with your organisation, the purpose of the enquiry and a contact name. The Secretariat can direct your message to the relevant office or committee.</p></details></div><p class="home-note">This is an association enquiry channel. Please do not send patient records or confidential clinical information. For urgent medical care, contact an appropriate healthcare service.</p></section>
</BaseLayout>
