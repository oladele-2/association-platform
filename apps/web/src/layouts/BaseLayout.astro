---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { tenant } from '../config/tenant';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = tenant.tagline,
  path = '/',
} = Astro.props;

const pageTitle =
  title === tenant.displayName ? title : `${title} · ${tenant.displayName}`;

const theme = {
  green: tenant.colors.green,
  greenDeep: tenant.colors.greenDeep,
  greenSoft: tenant.colors.greenSoft,
  red: tenant.colors.red,
  ink: tenant.colors.ink,
  mist: tenant.colors.mist,
};
---

<!doctype html>
<html lang="en" style={`--green:${theme.green};--green-deep:${theme.greenDeep};--green-soft:${theme.greenSoft};--red:${theme.red};--ink:${theme.ink};--mist:${theme.mist};`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={tenant.images.logo} />
    <link rel="canonical" href={path} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&family=Fraunces:opsz,wght@9..144,500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header currentPath={path} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
