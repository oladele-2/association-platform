// Association Management Platform — Prisma Schema
// Source of truth mirrored from docs/database/schema.prisma (approved).
// PostgreSQL 16+ | Shared schema + RLS (see docs/database/rls_and_partial_indexes.sql)
// Partial unique indexes / RLS applied via raw SQL migrations (Milestone 1).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
  extensions = [pgcrypto, citext]
}

// =============================================================================
// Enums — closed sets stable across all association types
// Tenant-specific vocabularies stay as String (membership type codes, institution types)
// =============================================================================

enum OrganizationStatus {
  provisioning
  active
  suspended
}

enum OrgType {
  professional_association
  alumni
  ngo
  society
  other
}

enum DomainPurpose {
  web
  portal
  api
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

enum PlatformUserStatus {
  active
  disabled
}

enum UserStatus {
  invited
  active
  disabled
}

enum MemberStatus {
  draft
  pending_approval
  active
  suspended
  archived
}

enum Sex {
  male
  female
  other
  unspecified
}

enum FieldEntity {
  member
  institution
}

enum FieldDataType {
  text
  number
  date
  boolean
  select
  url
}

enum FieldVisibility {
  admin_only
  admin_and_member
  public
}

enum InstitutionOwnership {
  public
  private
}

enum EmploymentStatus {
  active
  transferred
  ended
}

enum FeePeriodType {
  annual
  one_time
  custom
}

enum FeeScheduleStatus {
  draft
  active
  closed
}

enum InvoiceStatus {
  draft
  open
  partially_paid
  paid
  waived
  cancelled
  void
}

enum PaymentPayerType {
  member
  institution
}

enum PaymentChannel {
  paystack
  manual
  bulk_institution
}

enum PaymentStatus {
  pending
  awaiting_verification
  succeeded
  failed
  rejected
  refunded
}

enum BulkRemittanceStatus {
  draft
  submitted
  allocated
  closed
}

enum MatchStatus {
  matched
  unmatched
  excluded
}

enum FileVisibility {
  private
  public
}

enum FileStatus {
  pending
  ready
  deleted
}

enum ContentType {
  page
  news
  blog
  circular
  download
  gallery_album
  executive
  past_executive
  committee
}

enum ContentStatus {
  draft
  scheduled
  published
  archived
}

enum CmeStatus {
  pending
  approved
  rejected
}

enum EventStatus {
  draft
  published
  cancelled
  completed
}

enum EventAssetType {
  photo
  document
}

enum RegistrationStatus {
  registered
  cancelled
  attended
  no_show
}

enum CampaignStatus {
  draft
  queued
  sending
  sent
  cancelled
}

enum DeliveryStatus {
  queued
  sent
  failed
  bounced
}

enum NotificationChannel {
  in_app
  push
  email
}

enum ActorType {
  user
  platform_user
  system
}

enum RoleScopeType {
  organization
  institution
  committee
}

enum DevicePlatform {
  android
  ios
  web
}

// =============================================================================
// PLATFORM
// =============================================================================

model Plan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  limits      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions OrganizationSubscription[]

  @@map("plans")
}

model PlatformUser {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String             @unique @db.Citext
  passwordHash String             @map("password_hash")
  name         String
  status       PlatformUserStatus @default(active)
  lastLoginAt  DateTime?          @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles PlatformUserRole[]

  @@map("platform_users")
}

model PlatformRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users PlatformUserRole[]

  @@map("platform_roles")
}

model PlatformUserRole {
  platformUserId String @map("platform_user_id") @db.Uuid
  platformRoleId String @map("platform_role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  role PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  @@id([platformUserId, platformRoleId])
  @@map("platform_user_roles")
}

model OrganizationSubscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(trialing)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
  @@map("organization_subscriptions")
}

// =============================================================================
// TENANCY
// =============================================================================

model Organization {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String             @unique
  legalName        String             @map("legal_name")
  displayName      String             @map("display_name")
  orgType          OrgType            @map("org_type")
  countryCode      String             @default("NG") @map("country_code") @db.Char(2)
  timezone         String             @default("Africa/Lagos")
  defaultCurrency  String             @default("NGN") @map("default_currency") @db.Char(3)
  status           OrganizationStatus @default(provisioning)
  settings         Json               @default("{}")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)

  subscription         OrganizationSubscription?
  domains              OrganizationDomain[]
  features             OrganizationFeature[]
  branding             OrganizationBranding?
  users                User[]
  roles                Role[]
  membershipTypes      MembershipType[]
  members              Member[]
  fieldDefinitions     FieldDefinition[]
  institutions         Institution[]
  feeSchedules         FeeSchedule[]
  invoices             Invoice[]
  payments             Payment[]
  files                FileObject[]
  contentItems         ContentItem[]
  committees           Committee[]
  cmeSubmissions       CmeSubmission[]
  events               Event[]
  emailTemplates       EmailTemplate[]
  emailCampaigns       EmailCampaign[]
  emailDeliveries      EmailDelivery[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  domainEventOutbox    DomainEventOutbox[]
  idempotencyKeys      IdempotencyKey[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  emailVerifyTokens    EmailVerificationToken[]
  deviceTokens         DeviceToken[]
  userRoles            UserRole[]
  memberFieldValues    MemberFieldValue[]
  institutionMembers   InstitutionMember[]
  institutionAdmins    InstitutionAdmin[]
  feeRules             FeeRule[]
  paymentAllocations   PaymentAllocation[]
  paymentEvidence      PaymentEvidence[]
  paystackTransactions PaystackTransaction[]
  receipts             Receipt[]
  bulkRemittances      BulkRemittance[]
  bulkRemittanceLines  BulkRemittanceLine[]
  contentAssets        ContentAsset[]
  committeeMembers     CommitteeMember[]
  eventSpeakers        EventSpeaker[]
  eventAssets          EventAsset[]
  eventRegistrations   EventRegistration[]

  @@index([status])
  @@map("organizations")
}

model OrganizationDomain {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  hostname           String        @unique @db.Citext
  purpose            DomainPurpose
  isPrimary          Boolean       @default(false) @map("is_primary")
  verificationToken  String?       @map("verification_token")
  verifiedAt         DateTime?     @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, purpose])
  @@map("organization_domains")
}

model OrganizationFeature {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  featureKey     String   @map("feature_key")
  enabled        Boolean  @default(false)
  config         Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, featureKey])
  @@map("organization_features")
}

model OrganizationBranding {
  organizationId    String   @id @map("organization_id") @db.Uuid
  logoFileId        String?  @map("logo_file_id") @db.Uuid
  faviconFileId     String?  @map("favicon_file_id") @db.Uuid
  primaryColor      String?  @map("primary_color")
  secondaryColor    String?  @map("secondary_color")
  emailFromName     String?  @map("email_from_name")
  emailFromAddress  String?  @map("email_from_address")
  socialLinks       Json     @default("{}") @map("social_links")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logoFile     FileObject?  @relation("BrandingLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  faviconFile  FileObject?  @relation("BrandingFavicon", fields: [faviconFileId], references: [id], onDelete: SetNull)

  @@map("organization_branding")
}

// =============================================================================
// IDENTITY
// =============================================================================

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  email             String     @db.Citext
  passwordHash      String     @map("password_hash")
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  status            UserStatus @default(invited)
  mustResetPassword Boolean    @default(false) @map("must_reset_password")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member                 Member?
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  deviceTokens           DeviceToken[]
  userRoles              UserRole[]
  institutionAdmins      InstitutionAdmin[]
  notifications          Notification[]
  verifiedPayments       Payment[]               @relation("PaymentVerifiedBy")
  initiatedPayments      Payment[]               @relation("PaymentInitiatedBy")
  issuedReceipts         Receipt[]
  reviewedCme            CmeSubmission[]         @relation("CmeReviewer")
  authoredContent        ContentItem[]           @relation("ContentAuthor")
  exemptionsApproved     Member[]                @relation("ExemptionApprover")
  uploadedFiles          FileObject[]            @relation("FileUploader")
  emailCampaignsCreated  EmailCampaign[]         @relation("CampaignCreator")

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("users")
}

model RefreshToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  familyId       String    @map("family_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  userAgent      String?   @map("user_agent")
  ip             String?   @db.Inet
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model DeviceToken {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  token          String         @unique
  platform       DevicePlatform
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// =============================================================================
// RBAC
// =============================================================================

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  roleId         String         @map("role_id") @db.Uuid
  scopeType      RoleScopeType? @map("scope_type")
  scopeId        String?        @map("scope_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([organizationId])
  @@index([roleId])
  @@map("user_roles")
}

// =============================================================================
// MEMBERS & CUSTOM FIELDS
// =============================================================================

model MembershipType {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  isDefault      Boolean   @default(false) @map("is_default")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members      Member[]
  feeRules     FeeRule[]

  @@unique([organizationId, code])
  @@map("membership_types")
}

model Member {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  userId                 String?      @unique @map("user_id") @db.Uuid
  membershipTypeId       String       @map("membership_type_id") @db.Uuid
  membershipNo           String?      @map("membership_no")
  title                  String?
  firstName              String       @map("first_name")
  middleName             String?      @map("middle_name")
  lastName               String       @map("last_name")
  sex                    Sex?
  dateOfBirth            DateTime?    @map("date_of_birth") @db.Date
  phone                  String?
  alternateEmail         String?      @map("alternate_email") @db.Citext
  photographFileId       String?      @map("photograph_file_id") @db.Uuid
  primaryInstitutionId   String?      @map("primary_institution_id") @db.Uuid
  status                 MemberStatus @default(draft)
  activatedAt            DateTime?    @map("activated_at") @db.Timestamptz(6)
  duesExempt             Boolean      @default(false) @map("dues_exempt")
  duesExemptReason       String?      @map("dues_exempt_reason")
  duesExemptApprovedById String?      @map("dues_exempt_approved_by") @db.Uuid
  duesExemptApprovedAt   DateTime?    @map("dues_exempt_approved_at") @db.Timestamptz(6)
  joinedOn               DateTime?    @map("joined_on") @db.Date
  metadata               Json         @default("{}")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  membershipType       MembershipType       @relation(fields: [membershipTypeId], references: [id], onDelete: Restrict)
  photographFile       FileObject?          @relation("MemberPhoto", fields: [photographFileId], references: [id], onDelete: SetNull)
  primaryInstitution   Institution?         @relation("PrimaryInstitution", fields: [primaryInstitutionId], references: [id], onDelete: SetNull)
  duesExemptApprovedBy User?                @relation("ExemptionApprover", fields: [duesExemptApprovedById], references: [id], onDelete: SetNull)
  fieldValues          MemberFieldValue[]
  institutionLinks     InstitutionMember[]
  invoices             Invoice[]
  payments             Payment[]
  cmeSubmissions       CmeSubmission[]
  eventRegistrations   EventRegistration[]
  bulkRemittanceLines  BulkRemittanceLine[]
  committeeMembers     CommitteeMember[]

  @@index([organizationId, status])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, primaryInstitutionId])
  @@index([organizationId, membershipNo])
  @@index([membershipTypeId])
  @@map("members")
}

model FieldDefinition {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  entity         FieldEntity     @default(member)
  key            String
  label          String
  dataType       FieldDataType   @map("data_type")
  options        Json?
  isRequired     Boolean         @default(false) @map("is_required")
  isUnique       Boolean         @default(false) @map("is_unique")
  sortOrder      Int             @default(0) @map("sort_order")
  visibility     FieldVisibility @default(admin_and_member)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  values       MemberFieldValue[]

  @@unique([organizationId, entity, key])
  @@map("field_definitions")
}

model MemberFieldValue {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  memberId          String   @map("member_id") @db.Uuid
  fieldDefinitionId String   @map("field_definition_id") @db.Uuid
  value             Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member          Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)

  @@unique([memberId, fieldDefinitionId])
  @@index([organizationId])
  @@index([fieldDefinitionId])
  @@map("member_field_values")
}

// =============================================================================
// INSTITUTIONS
// =============================================================================

model Institution {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  code             String?
  name             String
  institutionType  String                @map("institution_type")
  ownership        InstitutionOwnership?
  state            String?
  lga              String?
  address          String?
  phone            String?
  email            String?               @db.Citext
  isAgpmpnMember   Boolean               @default(false) @map("is_agpmpn_member")
  status           String                @default("active")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
