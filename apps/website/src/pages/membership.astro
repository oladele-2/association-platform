---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { portalLinks } from '../data/site';
---
<BaseLayout title="Membership — NMA Ogun" description="Find guidance on accessing the NMA Ogun member portal and starting registration.">
  <PageHero eyebrow="Membership" title="Your professional community." description="The member portal provides a place to maintain your profile and access the association’s member services." />
  <section class="container page-section split-section"><div><div class="documentary-image"><Photo name="community-meeting" loading="eager" /></div><p class="image-note">United by a commitment to care.</p></div><div><p class="eyebrow">Joining NMA Ogun</p><h2>A place to connect.<br /><em>A purpose to share.</em></h2><ol class="numbered-list section-link"><li><span class="row-number">01</span><div><h3>Start your registration</h3><p>Open the NMA Ogun registration page in the member portal.</p></div></li><li><span class="row-number">02</span><div><h3>Introduce yourself</h3><p>Enter the required information and select your affiliate where applicable.</p></div></li><li><span class="row-number">03</span><div><h3>Follow the next steps</h3><p>Follow the portal’s instructions for your application and member profile. Registration does not imply automatic membership acceptance.</p></div></li></ol><div class="action-row"><a class="button" href={portalLinks.register}>Start registration <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="container page-section link-panels" aria-label="Member services"><div class="link-panel"><h2>Already a member?</h2><p>Sign in to maintain your profile and access member services.</p><a class="text-link" href={portalLinks.login}>Member portal <span aria-hidden="true">↗</span></a></div><div class="link-panel"><h2>Need access?</h2><p>Use the portal’s password recovery options if you cannot sign in.</p><a class="text-link" href={portalLinks.recovery}>Recover your account <span aria-hidden="true">↗</span></a></div><div class="link-panel"><h2>Our shared purpose</h2><p>Explore the mission, vision and values behind the association’s work.</p><a class="text-link" href="/about">About NMA Ogun <span aria-hidden="true">↗</span></a></div></section>
  <section class="container page-section"><p class="eyebrow">Useful to know</p><h2>Membership questions</h2><div class="faq"><details><summary>Where do I register?</summary><p>Registration takes place in the existing NMA Ogun member portal. Use the Start registration link above and follow the portal’s instructions.</p></details><details><summary>Does this website collect my membership details?</summary><p>The public website links to the portal. It does not provide a separate membership registration form.</p></details><details><summary>Where can I find joining requirements and fees?</summary><p>Follow the current instructions in the NMA Ogun portal. This website does not quote joining fees or promise processing times.</p></details></div></section>
</BaseLayout>
