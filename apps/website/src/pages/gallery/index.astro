---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Membership from '../../components/Membership.astro';
import { albums } from '../../data/media';
---
<BaseLayout title="Gallery — NMA Ogun" description="Explore photographs of NMA Ogun’s spaces and meeting life.">
  <PageHero eyebrow="In pictures" title="Our community, in pictures." description="A view of the association’s spaces and meeting life, through the photographs supplied by NMA Ogun." />
  <section class="container page-section album-grid" aria-label="Photo albums">{albums.map(album => <a class="album-link" href={`/gallery/${album.slug}`}><div class="album-image"><Photo name={album.cover} /></div><h2>{album.title}</h2><p>{album.description}</p><span class="text-link">Explore {album.photos.length} photographs <span aria-hidden="true">↗</span></span></a>)}</section>
  <Membership />
</BaseLayout>
