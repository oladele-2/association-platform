{
  "name": "@association/platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "dev:worker": "pnpm --dir ../webapp exec wrangler dev --config ../platform/wrangler.jsonc --port 8787",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist",
    "deploy": "pnpm build && pnpm --dir ../webapp exec wrangler deploy --config ../platform/wrangler.jsonc",
    "deploy:dry-run": "pnpm build && pnpm --dir ../webapp exec wrangler deploy --config ../platform/wrangler.jsonc --dry-run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^2.1.9"
  }
}
