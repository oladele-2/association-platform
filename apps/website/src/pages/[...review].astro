---
import { Image } from 'astro:assets';
import portraits from '#review-portraits';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { reviewMode, portalLinks } from '../data/site';
import { reviewSections, officers, affiliates, history } from '../data/review';

export function getStaticPaths() {
  return reviewMode ? reviewSections.filter(section => section !== "committees").map(section => ({ params: { review: section }, props: { section } })) : [];
}
const { section } = Astro.props;
const metadata = {
  review: { label: 'Website review', title: 'A closer look at the website.', description: 'Explore the implemented pages, review the content and see what remains before public launch.' },
  leadership: { label: 'Leadership', title: 'Leadership in service of the profession.', description: 'Meet the officers supporting the work of NMA Ogun. This roster is presented for editorial review.' },
  'leadership/past': { label: 'Past leadership', title: 'A legacy of service.', description: 'An extract from the supplied past leadership archive. Unresolved terms and incomplete names are held back.' },
  committees: { label: 'Committees', title: 'Shared expertise. Collective purpose.', description: 'The committees and chair names transcribed from the supplied association material, presented for review.' },
  affiliates: { label: 'Affiliates', title: 'Connected by professional purpose.', description: 'A review of affiliate candidates recorded in the NMA Ogun source material. Current status and official names need confirmation.' },
  resources: { label: 'Resources', title: 'Knowledge to share.', description: 'The resource section is ready for reviewed publications and documents approved for public access.' },
  contact: { label: 'Contact', title: 'Connect with NMA Ogun.', description: 'Association enquiries, membership guidance and partnership discussions begin with the right point of contact.' },
}[section];
const portraitFor = (filename: string) => portraits[filename];
const serving = officers.filter(person => !person.office.startsWith('Immediate Past'));
const past = officers.filter(person => person.office.startsWith('Immediate Past'));
const pageLinks = [
  { href: '/', title: 'Homepage', description: 'Association identity, purpose, meeting photography and membership journeys.' },
  { href: '/about', title: 'About NMA Ogun', description: 'Source-transcribed mission, vision and core values.' },
  { href: '/membership', title: 'Membership', description: 'Joining guidance, sign-in and account recovery handoffs.' },
  { href: '/programmes', title: 'Programmes', description: 'Professional learning and an event template without unconfirmed logistics.' },
  { href: '/gallery', title: 'Gallery', description: 'Two albums with captioned photographs and an accessible image viewer.' },
  { href: '/leadership', title: 'Leadership', description: 'Candidate officer portraits and offices. The disputed title is excluded.' },
  { href: '/leadership/past', title: 'Past leadership', description: 'Historical HTML archive with incomplete or disputed rows held back.' },
  { href: '/committees', title: 'Committees', description: 'Searchable committee and chair list for roster review.' },
  { href: '/affiliates', title: 'Affiliates', description: 'Searchable source candidates, awaiting status confirmation.' },
  { href: '/news', title: 'News & media', description: 'Article listing and detail template using clearly labelled purpose copy.' },
  { href: '/contact', title: 'Contact', description: 'Member-service help with no invented email, address, phone or form delivery.' },
  { href: '/resources', title: 'Resources', description: 'Download policy and editorial hold. No internal source files are published.' },
  { href: '/privacy', title: 'Privacy', description: 'Current preview behaviour and operational decisions needed before launch.' },
  { href: '/accessibility', title: 'Accessibility', description: 'Navigation guidance and the scope of accessibility review.' },
];
---
<BaseLayout title={`${metadata.label} — NMA Ogun`} description={metadata.description} reviewNote="Editorial preview · Candidate records are not approved for publication.">
  <PageHero eyebrow={metadata.label} title={metadata.title} description={metadata.description} parent={section === 'leadership/past' ? { href: '/leadership', label: 'Leadership' } : undefined} />
  {section === 'review' && <section class="container page-section"><div class="notice"><h2>Phase 3 implementation review</h2><p>This is a local website preview. Pages marked for editorial review are excluded from the normal build. Content, photograph permissions, contacts and roster sign-off remain open. The public website has no connection to the member database.</p></div><div class="review-grid">{pageLinks.map(page => <article class="review-card"><h2>{page.title}</h2><p>{page.description}</p><a class="text-link" href={page.href}>Open page <span aria-hidden="true">↗</span></a></article>)}</div></section>}

  {section === 'leadership' && <section class="container page-section"><div class="notice"><h2>Roster awaiting confirmation</h2><p>Names and offices below follow the supplied poster and are candidates for review. The disputed officer title and filename-only assistant appointments are omitted. No biographies, personal contacts or chairman’s message have been invented.</p></div><p class="eyebrow">State Officers’ Committee · Source roster</p><div class="officer-grid">{serving.map(person => <article class="officer"><div class="officer-photo">{portraitFor(person.portrait) && <Image src={portraitFor(person.portrait)} alt={person.name} widths={[320, 480]} sizes="(max-width: 600px) 45vw, 30vw" format="webp" loading="lazy" />}</div><p class="eyebrow">{person.office}</p><h3>{person.name}</h3><p>Appointment and public name awaiting confirmation.</p></article>)}</div><h2>Immediate past officers</h2><div class="officer-grid">{past.map(person => <article class="officer"><div class="officer-photo">{portraitFor(person.portrait) && <Image src={portraitFor(person.portrait)} alt={person.name} widths={[320, 480]} sizes="(max-width: 600px) 45vw, 30vw" format="webp" loading="lazy" />}</div><p class="eyebrow">{person.office}</p><h3>{person.name}</h3></article>)}</div><div class="action-row"><a class="text-link" href="/leadership/past">Past leadership archive <span aria-hidden="true">↗</span></a><a class="text-link" href="/committees">Explore committees <span aria-hidden="true">↗</span></a></div></section>}

  {section === 'leadership/past' && <section class="container page-section"><div class="notice"><h2>A source extract for review</h2><p>This archive does not establish the branch’s founding date or uninterrupted terms. Incomplete names and unresolved transitions have been omitted. No private phone numbers from the original document are included.</p></div><form class="directory-form" data-directory-search="history-directory" role="search"><label for="history-search">Search by name or term<input id="history-search" type="search" placeholder="Name or year" /></label><p data-result-count aria-live="polite">{history.length} entries</p></form><div class="table-wrap" tabindex="0" role="region" aria-label="Historical leadership table"><table><caption>Source term labels retained; a dash means the secretary was not supplied.</caption><thead><tr><th scope="col">Source term</th><th scope="col">Chairman</th><th scope="col">Secretary</th></tr></thead><tbody id="history-directory">{history.map(person => <tr data-search-text={`${person.years} ${person.chairman} ${person.secretary ?? ''}`}><td>{person.years}</td><td>{person.chairman}</td><td>{person.secretary ?? '—'}</td></tr>)}</tbody></table></div><a class="text-link section-link" href="/leadership">Current leadership review <span aria-hidden="true">↗</span></a></section>}


  {section === 'affiliates' && <section class="container page-section"><div class="notice"><h2>Affiliate candidates for review</h2><p>These names come from Ogun-specific application source records. They do not establish current affiliate status. Official names, descriptions and public-use logos require review. The registration fallback “Other” is excluded.</p></div><form class="directory-form" data-directory-search="affiliate-directory" role="search"><label for="affiliate-search">Find an affiliate candidate<input id="affiliate-search" type="search" placeholder="Name or abbreviation" /></label><p data-result-count aria-live="polite">{affiliates.length} entries</p></form><div id="affiliate-directory">{affiliates.map((affiliate, index) => <article class="directory-row" data-search-text={`${affiliate.name} ${affiliate.code}`}><span>{String(index + 1).padStart(2, '0')}</span><h2>{affiliate.name}</h2><p>{affiliate.code}</p></article>)}</div><a class="text-link section-link" href="/membership">Membership guidance <span aria-hidden="true">↗</span></a></section>}

  {section === 'resources' && <section class="container page-section split-section"><div class="documentary-image"><Photo name="doctors-house" /></div><div class="prose"><span class="review-tag">Editorial hold</span><h2>Publications with a public purpose.</h2><p>No supplied document is currently approved as a public download. This section will be populated with reviewed publications, their descriptions, file types and file sizes.</p><p>The member-response workbook, internal proposal and original historical archive are excluded from website assets. The archive’s private phone columns are not suitable for publication.</p><a class="text-link" href="/about">Explore our mission &amp; values <span aria-hidden="true">↗</span></a></div></section>}

  {section === 'contact' && <section class="container page-section"><div class="notice"><h2>Secretariat contact details awaiting confirmation</h2><p>The official email spelling, postal address, public telephone and office hours still need confirmation. An enquiry form will be enabled after its delivery and privacy arrangements have been implemented and tested.</p></div><div class="link-panels"><div class="link-panel"><h2>Membership guidance</h2><p>Find the steps to start registration and access member services.</p><a class="text-link" href="/membership">Joining NMA Ogun <span aria-hidden="true">↗</span></a></div><div class="link-panel"><h2>Account access</h2><p>Use the member portal’s recovery options if you cannot sign in.</p><a class="text-link" href={portalLinks.recovery}>Recover access <span aria-hidden="true">↗</span></a></div><div class="link-panel"><h2>Existing members</h2><p>Open your member portal for profile and association services.</p><a class="text-link" href={portalLinks.login}>Member portal <span aria-hidden="true">↗</span></a></div></div></section>}
</BaseLayout>
