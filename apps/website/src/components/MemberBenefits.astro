---
import { memberBenefits } from '../data/resource-features.mjs';
---
<section class="container home-section member-benefits" aria-labelledby="member-benefits-title"><div class="home-section-heading"><div><p class="eyebrow">Inside your member portal</p><h2 id="member-benefits-title">More than a sign-in.<br /><em>Support for your working life.</em></h2></div><p>Your services are available after sign-in, according to your membership and account permissions.</p></div><div class="home-services">{memberBenefits.map((item, index) => <a href={`https://portal.nmaogun.com.ng${item.href}`}><span aria-hidden="true">{String(index + 1).padStart(2,'0')} /</span><h3>{item.title}</h3><p>{item.text}</p><span class="text-link">{item.action} ↗</span></a>)}</div><div class="home-link-row"><a class="text-link" href="https://portal.nmaogun.com.ng/register">New here? Start registration ↗</a><a class="text-link" href="https://portal.nmaogun.com.ng/forgot-password">Recover your account ↗</a><a class="text-link" href="/membership">Membership guidance ↗</a></div></section>
