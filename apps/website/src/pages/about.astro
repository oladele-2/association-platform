---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotobookImage from '../components/PhotobookImage.astro';
import Photo from '../components/Photo.astro';
import Membership from '../components/Membership.astro';
---
<BaseLayout title="About NMA Ogun — Our purpose & values" description="Explore the mission, vision and core values of the Nigerian Medical Association, Ogun State Branch.">

    <section class="about-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About NMA Ogun</span></nav><div class="about-hero-grid"><div><p class="eyebrow">About the association</p><h1>A shared purpose.<br><em>A healthier Ogun.</em></h1></div><p>The Ogun State Branch of the Nigerian Medical Association brings together medical and dental practitioners around professional development, ethical practice, advocacy and members’ welfare.</p></div><figure class="about-panorama"><PhotobookImage page={8} eager /><figcaption><span>Our professional community</span><span>Inaugural SOC meeting · 4 August 2026.</span></figcaption></figure></div></section>
    <nav class="page-nav container" aria-label="On this page"><span>On this page</span><a href="#purpose">Our mission</a><a href="#vision">Our vision</a><a href="#values">Core values</a><a href="#community">Our community</a></nav>
    <section class="mission-section container section-space" id="purpose" aria-labelledby="mission-title"><div class="mission-heading"><p class="eyebrow">01 / Our mission</p><h2 id="mission-title">Better care begins<br>with a <em>stronger<br>profession.</em></h2></div><div class="mission-statement"><p>To build a sustainable professional association of medical and dental practitioners that will advance the delivery of qualitative health care services through continuing professional development, advocacy and policy development, knowledge management and public education, in collaboration with other collaborating partners in health</p><span class="statement-label">Our shared professional purpose</span></div></section>
    <section class="vision-section" id="vision" aria-labelledby="vision-title"><div class="container vision-layout"><p class="eyebrow" id="vision-title">02 / Our vision</p><blockquote>To become a formidable professional body committed to fostering effective and efficient health care delivery with high ethical standards and protecting the interest of its members.</blockquote><span class="vision-mark" aria-hidden="true">✳</span></div></section>
    <section class="core-values container section-space" id="values" aria-labelledby="values-title"><div class="section-heading"><p class="eyebrow">03 / Our core values</p><h2 id="values-title">The standards<br>we <em>stand for.</em></h2><p>A shared foundation for professional practice and service.</p></div><ol class="values-list"><li><span>01</span><h3>High Ethical Standards of Practice</h3></li><li><span>02</span><h3>Welfare of Members</h3></li><li><span>03</span><h3>Compassionate Service</h3></li><li><span>04</span><h3>Integrity</h3></li><li><span>05</span><h3>Professionalism and Excellence</h3></li></ol></section>
    <section class="community-section container" id="community" aria-labelledby="community-title"><div class="community-image"><Photo name="meeting-life" alt="People meeting around a table beneath NMA signage" /></div><div class="community-copy"><p class="eyebrow">Our community</p><h2 id="community-title">A place to connect.<br><em>A purpose to share.</em></h2><p>Doctors’ House is part of the association’s physical identity and meeting life. Explore photographs of the building and meeting spaces in our gallery.</p><a href="/gallery" class="text-link">See our community in pictures <span aria-hidden="true">↗</span></a></div></section>
    <section class="container page-section book-banner"><PhotobookImage page={53} /><div><p class="eyebrow">NMA Ogun at work</p><h2>A record of shared purpose.</h2><p>The photobook brings together executive meetings, stakeholder engagements, community outreach and association life from July to October 2026.</p><a class="text-link" href="/photobook">Explore the photobook ↗</a></div></section>
    <Membership />
  
</BaseLayout>
