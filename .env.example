# Local / shared environment template (copy to `.env` — never commit secrets)

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Prefer Neon in team/dev; Docker Compose Postgres is available for offline work:
# DATABASE_URL="postgresql://association:association@localhost:5432/association_platform?schema=public"
# DATABASE_URL_UNPOOLED="postgresql://association:association@localhost:5432/association_platform?schema=public"

# Neon (recommended)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.region.aws.neon.tech/association_db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/association_db?sslmode=require"

REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access-min-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-min-16-chars"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
APP_PUBLIC_URL="http://localhost:4321"

# Comma-separated browser origins for credentialed CORS (cookies). Leave unset for local defaults
# (portal :5173/:5174, Astro :4321). Example: CORS_ORIGINS="https://app.example.com,https://www.example.com"
# CORS_ORIGINS=

# One-time platform bootstrap (omit in production after first operator exists). Min 16 chars when set.
PLATFORM_BOOTSTRAP_SECRET="change-me-bootstrap-secret"

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
# Production requires full R2_* (or set ALLOW_MOCK_STORAGE=true explicitly for smoke-only hosts).
# Partial R2 env is rejected at boot. Dev/CI default to mock ObjectStorage when R2_* are empty.
# ALLOW_MOCK_STORAGE=true

PAYSTACK_SECRET_KEY=""
# Production requires PAYSTACK_SECRET_KEY (or set ALLOW_MOCK_PAYSTACK=true explicitly for smoke-only hosts).
# Dev/CI default to mock Paystack when PAYSTACK_SECRET_KEY is empty.
# ALLOW_MOCK_PAYSTACK=true

# Email (M9b)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# Production requires SMTP_HOST or explicit ALLOW_MOCK_EMAIL=true.
# ALLOW_MOCK_EMAIL=true
# EMAIL_DRAIN_INTERVAL_MS=5000

# Push / FCM (M11)
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Production requires both Firebase vars or explicit ALLOW_MOCK_PUSH=true.
# ALLOW_MOCK_PUSH=true

# Skip connectivity/RLS smoke tests when Neon (or migrated local Postgres) is unavailable.
# CI migrates its Postgres service and does NOT set this — smoke runs there.
# SKIP_DB_SMOKE=true
