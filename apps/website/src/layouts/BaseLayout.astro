---
import { Image, getImage } from 'astro:assets';
import logo from '../assets/nma-ogun-logo.png';
import { site, mainLinks, portalLinks, reviewMode } from '../data/site';
import { articles } from '../data/editorial';
import PhotoViewer from '../components/PhotoViewer.astro';
import '../styles/base.css';
import '../styles/pages.css';
import '../styles/publication.css';
interface Props { title: string; description: string; reviewNote?: string; article?: boolean }
const { title, description, reviewNote, article = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, site.origin).href;
const socialImage = { src: '/social/nma-ogun-share.png' };
const noIndex = reviewMode || path === '/404' || path === '/404.html' || path === '/publication-shell';
const brandImage = await getImage({ src: logo, width: 410, format: 'webp' });
const organisation = { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.origin, logo: new URL(brandImage.src, site.origin).href };
const active = (href: string) => path === href || (href !== '/' && path.startsWith(`${href}/`));
---
<!doctype html>
<html lang="en-NG"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content={noIndex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} /><meta name="theme-color" content="#143e31" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:site_name" content={site.shortName} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(socialImage.src, site.origin).href} />
  <meta property="og:image:secure_url" content={new URL(socialImage.src, site.origin).href} />
  <meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="NMA Ogun State — Nigerian Medical Association. Healthier People. A Stronger Ogun." /><meta property="og:locale" content="en_NG" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(socialImage.src, site.origin).href} />
  <meta name="twitter:image:alt" content="NMA Ogun State — Nigerian Medical Association" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/NotoSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/NotoSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
  {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(organisation).replaceAll('<', '\\u003c')} />}
</head><body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="utility"><div class="container"><span>Nigerian Medical Association <span class="utility-separator">/</span> Ogun State Branch</span><a href={portalLinks.register}>Become a member <span aria-hidden="true">↗</span></a></div></div>
  <header class="site-header"><div class="container header-inner">
    <a class="brand" href="/" aria-label="NMA Ogun home"><Image src={logo} width={410} widths={[205,410]} sizes="(max-width: 600px) 165px, 205px" format="webp" alt="NMA Ogun State — Nigerian Medical Association" loading="eager" /></a>
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-navigation"><span>Menu</span><span class="menu-lines" aria-hidden="true"></span></button>
    <nav id="site-navigation" aria-label="Main navigation">{mainLinks.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}<a class="button button-small" href={portalLinks.login}>Member portal <span aria-hidden="true">↗</span></a></nav>
  </div></header>
  {reviewMode && <aside class="preview-bar"><div class="container"><span>{reviewNote ?? 'Website preview · Content and photography awaiting final approval.'}</span><a href="/review">Review all pages <span aria-hidden="true">↗</span></a></div></aside>}
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="site-footer"><div class="container"><div class="footer-main"><div><a class="brand footer-brand" href="/" aria-label="NMA Ogun home"><Image src={logo} width={410} format="webp" alt="NMA Ogun State" loading="lazy" /></a><p>Professional purpose.<br />A shared commitment to better healthcare.</p></div><div class="footer-links"><h2>Explore</h2><a href="/about">About NMA Ogun</a><a href="/executives">Our executives</a><a href="/committees">Committee chairmen</a><a href="/programmes">Programmes</a><a href="/gallery">In pictures</a>{articles.length > 0 && <a href="/news">News &amp; media</a>}{reviewMode && <><a href="/leadership">Leadership</a><a href="/committees">Committees</a><a href="/affiliates">Affiliates</a><a href="/resources">Resources</a><a href="/contact">Contact</a></>}</div><div class="footer-links"><h2>For members</h2><a href="/membership">Membership guidance</a><a href={portalLinks.login}>Member portal ↗</a><a href={portalLinks.register}>Start registration ↗</a><a href={portalLinks.recovery}>Recover access ↗</a><a href="/privacy">Privacy</a><a href="/accessibility">Accessibility</a></div></div><div class="footer-bottom"><p>Nigerian Medical Association · Ogun State Branch</p><a href="#main">Back to top <span aria-hidden="true">↑</span></a></div></div></footer>
  <PhotoViewer />
  <script src="../scripts/site.ts"></script>
</body></html>
