---
import BaseLayout from '../layouts/BaseLayout.astro';
import { validateSnapshot } from '../../vendor/website-content/index.ts';
import { renderExecutivePage } from '../../vendor/website-content/render.ts';
import snapshot from '../../content/release/snapshot.json';
import '../styles/leadership.css';
const page = renderExecutivePage(validateSnapshot(snapshot));
---
<BaseLayout title={page.title + ' — State Officers'} description={page.description}>
  <Fragment set:html={page.html} />
</BaseLayout>
