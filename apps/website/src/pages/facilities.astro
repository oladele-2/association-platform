---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PhotobookGallery from '../components/PhotobookGallery.astro';
import Photo from '../components/Photo.astro';
import bus from '../assets/newsletter/nma-bus.jpg';
import { publication, secretariatEmail } from '../data/home';
import { newsletterEdition } from '../data/newsletter';
import '../styles/home.css';
const edition = newsletterEdition(publication);
---
<BaseLayout title="Doctors’ House & bus hire — NMA Ogun" description="Enquire about Doctors’ House venue hire and NMA Ogun bus hire, with service information published in the biannual newsletter.">
  <PageHero eyebrow="Facilities & services" title="A place to gather. A way to connect." description="Explore venue and transport enquiries for professional events and community occasions. Confirm current availability and arrangements before making a booking." />
  <section class="container page-section issue-services"><article><figure><Photo name="doctors-house" /></figure><p class="eyebrow">Doctors’ House</p><h2>Bring your event together.</h2><p>The 2026 newsletter advertises NMA House for conferences, meetings, receptions and celebrations.</p><address>NMA House, Lukosi Road, off Abiola Way,<br />Leme, Abeokuta, Ogun State.</address>{edition && <><p class="newsletter-note">Venue booking contact published in the newsletter: Abbey.</p><a href="tel:+2348185131707">0818 513 1707</a></>}<p><a class="text-link" href={`mailto:${secretariatEmail}?subject=Doctors%20House%20venue%20enquiry`}>Enquire through the Secretariat ↗</a></p></article><article><figure><Image src={bus} width={650} widths={[400,650]} sizes="(max-width:600px) 90vw, 45vw" format="webp" alt="NMA Ogun bus pictured in the newsletter’s bus-hire notice" loading="lazy" /></figure><p class="eyebrow">Group transport</p><h2>Travel together.</h2><p>The newsletter introduces an 18-seater bus for conferences, airport runs, events and group trips. Ask about the vehicle, route, travel dates and booking arrangements.</p>{edition && <><p class="newsletter-note">Bus booking contact published in the newsletter.</p><a href="tel:+2348021328127">0802 132 8127</a></>}<p><a class="text-link" href={`mailto:${secretariatEmail}?subject=NMA%20bus%20hire%20enquiry`}>Enquire through the Secretariat ↗</a></p></article></section>
  <section class="container page-section prose"><h2>Before making arrangements</h2><p>Provide your preferred date, event or journey details, estimated attendance or passenger count, and a contact name. Obtain confirmation of availability, charges, facilities, transport arrangements and any applicable terms directly from the booking contact.</p><p>No prices or booking guarantees are published here. The service descriptions and booking contacts come from the Third Edition, 2026 newsletter; confirm current details before travelling or making payment.</p>{edition && <a class="text-link" href={`${edition.href}#page=52`}>View the newsletter’s original service notice ↗</a>}<p>For other association enquiries, email <a href={`mailto:${secretariatEmail}`}>{secretariatEmail}</a>.</p></section>
  <section class="container page-section book-section"><p class="eyebrow">A closer look at NMA Hall</p><h2>A setting for your next gathering.</h2><p>The working photobook shows the hall arranged for different occasions, together with views of the building and compound. These are photographs of past arrangements; confirm the current layout and available facilities when enquiring.</p><PhotobookGallery pages={[43,44,45,49]} /><a class="text-link section-link" href="/gallery/doctors-house-and-hall-2026">Explore Doctors’ House &amp; NMA Hall ↗</a></section>
</BaseLayout>
